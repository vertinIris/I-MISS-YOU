# ============================================================
# 飞行雪绒 — 环境变量配置示例
# ============================================================
# 本项目为纯前端静态站，不使用 .env 文件加载环境变量。
# Supabase 配置直接写入 js/supabase-adapter.js 顶部的 CONFIG 对象。
#
# 此文件仅作为配置项参考，方便在新平台上快速还原环境。
# ============================================================

# ----------------------------------------------------------
# Supabase 配置（必填，用于云端同步功能）
# ----------------------------------------------------------
# 获取方式：Supabase Dashboard → Settings → API
# Project URL 格式：https://xxxxx.supabase.co

SUPABASE_URL=https://lmlyfyjffaaddysiliht.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# ----------------------------------------------------------
# 管理员口令（用于评论删除功能）
# ----------------------------------------------------------
# 此处为明文，实际代码中存储的是 SHA-256 哈希值。
# 如需修改口令，用以下命令生成新哈希并替换 admin-auth.js 中的 ADMIN_PASSWORD_HASH：
#   echo -n "your_password" | sha256sum
# 或在浏览器控制台执行：
#   await crypto.subtle.digest('SHA-256', new TextEncoder().encode('your_password'))

ADMIN_PASSWORD=flyingedelweiss2026
ADMIN_PASSWORD_HASH=70a05acb8e8b4c2b3ac7d7f7a6e5d4c3b2a190876543210fedcba9876543210

# ----------------------------------------------------------
# GitHub Pages 部署配置
# ----------------------------------------------------------
# 部署后在 Supabase Dashboard → Authentication → URL Configuration 中设置

SITE_URL=https://your-username.github.io/your-repo-name/
REDIRECT_URLS=https://your-username.github.io/your-repo-name/

# ----------------------------------------------------------
# CDN 配置（可选，默认使用 jsdelivr）
# ----------------------------------------------------------
# 如果目标平台无法访问 jsdelivr，可更换为以下 CDN：
#   unpkg:      https://unpkg.com/three@0.128.0/build/three.min.js
#   cdnjs:      https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js
#   Supabase:   https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2

THREE_JS_CDN=https://cdn.jsdelivr.net/npm/three@0.128.0/build/three.min.js
SUPABASE_SDK_CDN=https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2

# ----------------------------------------------------------
# Supabase 项目信息（参考）
# ----------------------------------------------------------
# 项目名称: fxre (飞行雪绒)
# 数据库: PostgreSQL 15
# 区域: Northeast Asia (Tokyo) / Southeast Asia (Singapore)
# Free Tier: 500MB 数据库 / 50k MAU / 1GB 文件存储 / 5GB 带宽
